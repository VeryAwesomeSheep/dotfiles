{
    // Editor
    "editor.tabSize": 2,
    "editor.autoIndentOnPaste": true,
    "editor.minimap.enabled": false,
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.lineNumbers": "on",
    "editor.renderWhitespace": "boundary",
    "editor.fontFamily": "'CaskaydiaMono Nerd Font', 'monospace'",
    "editor.fontSize": 16,
    "editor.stickyScroll.enabled": true,
    "editor.insertSpaces": true,
    // Files
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    // Workbench
    "window.newWindowProfile": "Default",
    "workbench.layoutControl.enabled": false,
    "workbench.sideBar.location": "right",
    "window.commandCenter": false,
    // Git
    "git.blame.editorDecoration.enabled": true,
    "git.blame.editorDecoration.template": "${authorName} (${authorDateAgo})",
    "git.blame.statusBarItem.template": "${subject} - ${authorName} (${authorDateAgo})",
    // AI
    "chat.disableAIFeatures": true,
    // Telemetry
    "telemetry.editStats.enabled": false,
    "telemetry.feedback.enabled": false,
    // Language specific
    "[c][cpp]": {},
    "[go]": {},
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter"
    },
    // Extensions
    // VSCodeVim
    "vim.statusBarColorControl": false,
    "vim.useSystemClipboard": true,
    "vim.useCtrlKeys": true,
    "vim.leader": "<space>",
    "vim.normalModeKeyBindings": [
        {
            // Disable vim plugin keybind "gd" to go to definition
            "before": [
                "g",
                "d",
            ],
            "commands": []
        },
        {
            "before": [
                "<leader>",
                "g",
                "d",
            ],
            "commands": [
                "editor.action.peekDefinition"
            ]
        },
        {
            "before": [
                "<leader>",
                "g",
                "D",
            ],
            "commands": [
                "editor.action.revealDefinition"
            ]
        },
        {
            "before": [
                ">"
            ],
            "commands": [
                "editor.action.indentLines"
            ]
        },
        {
            "before": [
                "<"
            ],
            "commands": [
                "editor.action.outdentLines"
            ]
        }
    ],
    "vim.insertModeKeyBindings": [
        {
            "before": [
                "j",
                "j"
            ],
            "after": [
                "<Esc>"
            ]
        }
    ],
    "vim.visualModeKeyBindings": [],
    // C/Cpp
    "C_Cpp.intelliSenseEngine": "disabled",
    // Go
    "gopls": {
        "ui.semanticTokens": true,
    },
    "go.formatTool": "gofmt",
    "go.toolsManagement.autoUpdate": true,
    // Python
    "python.analysis.typeCheckingMode": "standard",
    "diffEditor.maxComputationTime": 0,
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmDelete": false,
    "security.workspace.trust.untrustedFiles": "open",
    "workbench.activityBar.location": "top",
    "workbench.colorTheme": "Dark Modern",
}
