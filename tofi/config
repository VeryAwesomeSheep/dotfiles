# https://github.com/philj56/tofi/blob/master/doc/config

# Font
font = CaskaydiaMono Nerd Font Propo
font-size = 12

# Text style
text-color = #E6DBC3
selection-color = #E6DBC3

# Text layout
prompt-text = "Run: "
num-results = 10
result-spacing = 15
input-color = #D9B863
default-result-color = #C05B4D
selection-match-color = #86A361

# Window theming
horizontal = true
anchor = top
margin-top = 10
margin-left = 10
margin-right = 10
width = 0
height = 35
background-color = #221F1E
outline-width = 1
outline-color = #E6DBC3
border-width = 0
padding-left = 18
padding-right = 10
padding-top = 6
padding-bottom = 5

# Behaviour
history = true
terminal = kitty
