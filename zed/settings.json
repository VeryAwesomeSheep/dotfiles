// Zed settings
//
// Zed settings documentation: https://zed.dev/docs/configuring-zed
// Default settings lookup: `zed: open default settings`
{
  // General
  "base_keymap": "VSCode",
  "vim_mode": true,
  "confirm_quit": true,

  // Font
  "buffer_font_family": "Cascadia Mono",
  "buffer_font_size": 16,
  "buffer_font_features": {
    "calt": false
  },
  "ui_font_family": "Cascadia Mono",
  "ui_font_size": 16,

  // Theme
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },
  "icon_theme": {
    "mode": "system",
    "light": "Colored Zed Icons Theme Light",
    "dark": "Colored Zed Icons Theme Dark"
  },

  // Editor
  "remove_trailing_whitespace_on_save": true,
  "show_whitespaces": "boundary",
  "tab_size": 2,
  "relative_line_numbers": true,
  "preferred_line_length": 80,
  "show_wrap_guides": true,
  "wrap_guides": [80],
  "active_pane_modifiers": {
    "magnification": 1,
    "border_size": 1,
    "inactive_opacity": 1.0
  },
  "format_on_save": "on",
  "inlay_hints": {
    "enabled": true
  },
  "show_edit_predictions": false, // TODO: reconsider?
  "soft_wrap": "editor_width",

  // Languages
  "languages": {},

  // Git
  "git": {
    "inline_blame": {
      "min_column": 80
    },
    "hunk_style": "unstaged_hollow"
  },

  // Diagnostics
  "diagnostics": {
    "include_warnings": true,
    "inline": {
      "enabled": true,
      "min_column": 80
    }
  },

  // Tab bar
  "tab_bar": {
    "show_nav_history_buttons": false
  },

  // Tabs
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "all"
  },

  // Project panel
  "project_panel": {
    "default_width": 360, // TODO: change when git panel width will be configurable
    "scrollbar": {
      "show": "auto"
    }
  },

  // Outline panel
  "outline_panel": {
    "default_width": 360, // TODO: change when git panel width will be configurable
    "scrollbar": {
      "show": "auto"
    }
  },

  // Extensions
  "auto_install_extensions": {
    "colored-zed-icons-theme": true
  }
}
